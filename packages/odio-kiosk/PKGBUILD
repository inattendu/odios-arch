# Maintainer: odios-arch fork
# Port Arch du .deb odio-kiosk (navigateur QtWebEngine framebuffer).
pkgname=odio-kiosk
pkgver=2.0.1
pkgrel=1
pkgdesc="QtWebEngine kiosk browser for the Linux framebuffer (odio)"
arch=('x86_64')
url="https://github.com/b0bbywan/odio-framebuffer-ui"
license=('MIT')
depends=('qt6-base' 'qt6-webengine' 'nss' 'curl')
makedepends=('cmake' 'qt6-base' 'qt6-webengine' 'pkgconf' 'git')
_tag="v$pkgver"
source=("$pkgname::git+https://github.com/b0bbywan/odio-framebuffer-ui.git#tag=$_tag")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd "$pkgname"
  # unit instanciée : @.user.service -> /usr/lib/systemd/user/odio-kiosk@.service
  install -Dm644 debian/odio-kiosk@.user.service \
    "$pkgdir/usr/lib/systemd/user/odio-kiosk@.service"
  install -Dm644 debian/odio-kiosk.default "$pkgdir/etc/default/odio-kiosk"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
